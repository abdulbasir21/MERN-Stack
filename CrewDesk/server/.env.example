PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.region.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-sample.region.neon.tech/neondb?sslmode=require

# JWT
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars_random
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars_random
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Initial Seed Owner
SEED_OWNER_EMAIL=owner@crewdesk.agency
SEED_OWNER_PASSWORD=ChangeMe123!

# ImageKit (Avatars only)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_endpoint
