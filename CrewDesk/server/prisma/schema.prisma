// Prisma schema for CrewDesk ERP
// Direct URL is configured for migrations (Neon direct), DATABASE_URL is for pooled connection.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  OWNER
  HR_MANAGER
  PROJECT_MANAGER
  FINANCE_MANAGER
  INVENTORY_MANAGER
  EMPLOYEE
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum MilestoneStatus {
  PENDING
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SENT
  CANCELLED
}

enum ExpenseCategory {
  SOFTWARE
  HARDWARE
  CONTRACTOR
  OFFICE
  TRAVEL
  MARKETING
  OTHER
}

enum PaymentMethod {
  BANK_TRANSFER
  CREDIT_CARD
  CHECK
  CASH
  OTHER
}

enum InventoryKind {
  ASSET
  STOCK
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  UNDER_MAINTENANCE
  DAMAGED
  RETIRED
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
}

model CompanySettings {
  id               String   @id @default(uuid())
  companyName      String   @default("CrewDesk Agency")
  currency         String   @default("USD")
  timezone         String   @default("UTC")
  officeStartTime  String   @default("09:00") // HH:mm
  lateGraceMinutes Int      @default(15)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LeaveType {
  id               String         @id @default(uuid())
  name             String         @unique // ANNUAL, SICK, CASUAL
  defaultAllowance Int            @default(0) // days per year
  balances         LeaveBalance[]
  requests         LeaveRequest[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model LeaveBalance {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  year        Int
  allowance   Int       @default(0)
  used        Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, leaveTypeId, year])
}

model LeaveRequest {
  id             String      @id @default(uuid())
  userId         String
  user           User        @relation("LeaveRequests", fields: [userId], references: [id], onDelete: Cascade)
  leaveTypeId    String
  leaveType      LeaveType   @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  startDate      DateTime
  endDate        DateTime
  daysCount      Int         // weekdays only (Mon-Fri)
  status         LeaveStatus @default(PENDING)
  reason         String
  decisionReason String?     // mandatory when status is REJECTED
  decidedById    String?
  decidedBy      User?       @relation("DecidedLeaves", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model Client {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  phone     String?
  company   String?
  notes     String?
  isDemo    Boolean   @default(false)
  projects  Project[]
  invoices  Invoice[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Project {
  id          String          @id @default(uuid())
  name        String
  clientId    String
  client      Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  description String?
  startDate   DateTime
  deadline    DateTime
  budget      Decimal         @db.Decimal(12, 2)
  status      ProjectStatus   @default(PLANNING)
  isDemo      Boolean         @default(false)
  managerId   String
  manager     User            @relation("ManagedProjects", fields: [managerId], references: [id], onDelete: Restrict)
  members     ProjectMember[]
  milestones  Milestone[]
  tasks       Task[]
  expenses    Expense[]
  invoices    Invoice[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("ProjectMemberships", fields: [userId], references: [id], onDelete: Cascade)
  role      String?  // e.g. "Lead Developer", "UX Designer"
  joinedAt  DateTime @default(now())

  @@unique([projectId, userId])
}

model Milestone {
  id          String          @id @default(uuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  dueDate     DateTime
  status      MilestoneStatus @default(PENDING)
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Task {
  id              String        @id @default(uuid())
  projectId       String
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  assigneeId      String
  assignee        User          @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: Restrict)
  createdById     String
  createdBy       User          @relation("CreatedTasks", fields: [createdById], references: [id], onDelete: Restrict)
  priority        TaskPriority  @default(MEDIUM)
  status          TaskStatus    @default(TODO)
  progressPercent Int           @default(0) // 0 - 100
  dueDate         DateTime
  comments        TaskComment[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model TaskComment {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
}

model Expense {
  id           String          @id @default(uuid())
  projectId    String?
  project      Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  category     ExpenseCategory @default(OTHER)
  amount       Decimal         @db.Decimal(12, 2)
  description  String
  date         DateTime
  receiptUrl   String?
  recordedById String
  recordedBy   User            @relation("RecordedExpenses", fields: [recordedById], references: [id], onDelete: Restrict)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique // e.g. "INV-2026-001"
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  projectId     String?
  project       Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  subtotal      Decimal       @db.Decimal(12, 2)
  tax           Decimal       @default(0.00) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  status        InvoiceStatus @default(DRAFT) // DRAFT, SENT, CANCELLED stored; PARTIALLY_PAID, PAID, OVERDUE derived
  issueDate     DateTime
  dueDate       DateTime
  notes         String?
  payments      Payment[]
  createdById   String
  createdBy     User          @relation("CreatedInvoices", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Payment {
  id           String        @id @default(uuid())
  invoiceId    String
  invoice      Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount       Decimal       @db.Decimal(12, 2)
  date         DateTime
  method       PaymentMethod @default(BANK_TRANSFER)
  reference    String?
  notes        String?
  recordedById String
  recordedBy   User          @relation("RecordedPayments", fields: [recordedById], references: [id], onDelete: Restrict)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Attendance {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         String    // YYYY-MM-DD in company timezone (unique per user per day)
  checkIn      DateTime
  checkOut     DateTime?
  workingHours Decimal?  @db.Decimal(5, 2) // CALCULATED, never manually input
  isLate       Boolean   @default(false)
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, date])
}

model User {
  id                 String            @id @default(uuid())
  name               String
  email              String            @unique
  passwordHash       String
  role               Role              @default(EMPLOYEE)
  title              String?
  phone              String?
  avatarUrl          String?
  avatarFileId       String?
  mustChangePassword Boolean           @default(true)
  isActive           Boolean           @default(true)
  isDemo             Boolean           @default(false)
  joinDate           DateTime          @default(now())
  departmentId       String?
  department         Department?     @relation(fields: [departmentId], references: [id])
  refreshTokens      RefreshToken[]
  notifications      Notification[]
  auditLogs          AuditLog[]      @relation("ActorAuditLogs")
  leaveBalances      LeaveBalance[]
  leaveRequests      LeaveRequest[]  @relation("LeaveRequests")
  decidedLeaves      LeaveRequest[]  @relation("DecidedLeaves")
  managedProjects    Project[]       @relation("ManagedProjects")
  projectMemberships ProjectMember[] @relation("ProjectMemberships")
  assignedTasks      Task[]          @relation("AssignedTasks")
  createdTasks       Task[]          @relation("CreatedTasks")
  taskComments       TaskComment[]
  attendances        Attendance[]
  recordedExpenses   Expense[]       @relation("RecordedExpenses")
  createdInvoices    Invoice[]       @relation("CreatedInvoices")
  recordedPayments   Payment[]       @relation("RecordedPayments")
  assignedAssets     InventoryItem[] @relation("AssignedAssets")
  assetAssignments   AssetAssignment[]
  recordedMovements  StockMovement[] @relation("RecordedMovements")
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)
  action     String   // e.g. "auth:login", "user:create"
  entityType String   // e.g. "User", "LeaveRequest"
  entityId   String?
  oldValues  Json?
  newValues  Json?
  createdAt  DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // e.g. "TASK", "LEAVE", "SYSTEM"
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model InventoryItem {
  id              String            @id @default(uuid())
  kind            InventoryKind     // ASSET or STOCK
  name            String
  category        String            // Laptops, Monitors, Peripherals, Stationery
  serialNumber    String?           @unique // Required/unique for ASSET
  assetStatus     AssetStatus?      @default(AVAILABLE) // For ASSET
  currentQuantity Int               @default(1) // For STOCK
  minQuantity     Int               @default(0) // Minimum threshold alert
  isDemo          Boolean           @default(false)
  assignedUserId  String?
  assignedUser    User?             @relation("AssignedAssets", fields: [assignedUserId], references: [id], onDelete: SetNull)
  location        String?
  notes           String?
  assignments     AssetAssignment[]
  movements       StockMovement[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model RateLimitBucket {
  key       String   @id
  count     Int      @default(1)
  resetAt   DateTime
  updatedAt DateTime @updatedAt
}

model AssetAssignment {
  id           String        @id @default(uuid())
  itemId       String
  item         InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt   DateTime      @default(now())
  assignedById String
  returnedAt   DateTime?
  returnedById String?
  condition    String?
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model StockMovement {
  id               String            @id @default(uuid())
  itemId           String
  item             InventoryItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type             StockMovementType
  quantity         Int
  previousQuantity Int
  newQuantity      Int
  reason           String
  recordedById     String
  recordedBy       User              @relation("RecordedMovements", fields: [recordedById], references: [id], onDelete: Restrict)
  createdAt        DateTime          @default(now())
}
