# ScopeSentry Server Environment Configuration Example
# Copy to server/env and fill with real credentials. Never commit server/env!

NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net
MONGODB_DB_NAME=scopesentry
MONGODB_TEST_URI=mongodb://localhost:27017/scopesentry_test

JWT_SECRET=your_jwt_secret_min_32_chars
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars
JWT_EXPIRES_IN=15m
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
CSRF_SECRET=your_csrf_secret_min_32_chars
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=localhost

IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id
NEXT_PUBLIC_URL_ENDPOINT=https://ik.imagekit.io/your_id

GEMINI_API_KEY=your_gemini_api_key
GEMINI_CHAT_MODEL=gemini-1.5-pro
GEMINI_EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSIONS=768

MAX_UPLOAD_MB=10
MAX_FILE_SIZE_MB=10
DEMO_RUN_LIMIT_PER_DAY=100
DEMO_RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

EMAIL_FROM=noreply@scopesentry.ai
EMAIL_HOST=smtp.mailgun.org
EMAIL_PORT=587
EMAIL_USER=postmaster@scopesentry.ai
EMAIL_PASS=smtp_password
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@scopesentry.ai
SMTP_PASS=smtp_password
