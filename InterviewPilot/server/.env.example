# Server Environment Variables (Names Only — Do NOT commit real values)
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:3000

# Database (Neon PostgreSQL + pgvector)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/dbname?sslmode=require
DIRECT_URL=postgresql://user:password@host/dbname?sslmode=require
TEST_DATABASE_URL=postgresql://user:password@host/test_dbname?sslmode=require
TEST_DATABASE_URL_UNPOOLED=postgresql://user:password@host/test_dbname?sslmode=require

# Authentication & Security
JWT_SECRET=replace_with_32_byte_random_secret
JWT_EXPIRES_IN=7d
DEMO_IP_HASH_SECRET=replace_with_32_byte_hmac_secret
ADMIN_BOOTSTRAP_EMAIL=admin@example.com

# Google Gemini API (Backend Only — Free-Tier Models)
GEMINI_API_KEY=replace_with_gemini_api_key
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Kore
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# ImageKit Private Storage
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_endpoint
IMAGEKIT_PUBLIC_KEY=public_placeholder
IMAGEKIT_PRIVATE_KEY=private_placeholder

# Email (SMTP / Password Reset)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=user@example.com
EMAIL_PASS=replace_with_email_password
EMAIL_FROM=noreply@example.com
