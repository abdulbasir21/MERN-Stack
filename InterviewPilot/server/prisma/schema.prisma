generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETING
}

enum UserStatusType {
  STUDENT
  PROFESSIONAL
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  EXPERIENCED
}

enum InterviewCategory {
  TECHNICAL
  HR
  BEHAVIORAL
}

enum QuotaProfile {
  DEMO
  FREE_USER
}

enum UsageScopeType {
  GLOBAL
  USER
}

enum UsagePeriodType {
  DAY
  MONTH
}

enum DocumentType {
  CV
  JD
}

enum DocumentSourceKind {
  FILE
  PASTED
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED
}

enum DocumentFailureReason {
  INVALID_FILE
  NO_TEXT
  EXTRACTION_FAILED
  PROCESSING_FAILED
}

enum AIOperationType {
  DOCUMENT_SUMMARY
  DOCUMENT_EMBEDDING
  QUERY_EMBEDDING
  INTERVIEW_PLAN
  ANSWER_EVALUATION
  CANDIDATE_INQUIRY
  REPORT_GENERATION
  SPEECH_TRANSCRIPTION
  SPEECH_SYNTHESIS
}

enum AIUsageStatus {
  RESERVED
  SETTLED
  RELEASED
  FAILED
  EXPIRED
}

model ApplicationSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String?
  role                UserRole             @default(USER)
  status              UserStatus           @default(ACTIVE)
  isDemo              Boolean              @default(false)
  tokenVersion        Int                  @default(0)
  lastLoginAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  profile             UserProfile?
  passwordResetTokens PasswordResetToken[]
  quota               UserQuota?
  aiUsageRecords      AIUsageRecord[]
  documents           UploadedDocument[]

  @@index([status, role, isDemo])
}

model UserProfile {
  id                    String              @id @default(cuid())
  userId                String              @unique
  fullName              String?
  statusType            UserStatusType?
  experienceLevel       ExperienceLevel?
  targetRole            String?
  careerGoals           String?
  preferredCategories   InterviewCategory[]
  onboardingCompletedAt DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model QuotaConfiguration {
  id                         String       @id @default(cuid())
  profile                    QuotaProfile @unique
  interviewsPerDay           Int
  maxDurationMinutes         Int
  maxQuestionsPerInterview   Int
  maxInquiriesPerInterview   Int
  documentAnalysesPerDay     Int
  reportGenerationsPerDay    Int
  concurrentActiveInterviews Int
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt
}

model UserQuota {
  id                         String   @id @default(cuid())
  userId                     String   @unique
  interviewsPerDay           Int?
  maxDurationMinutes         Int?
  maxQuestionsPerInterview   Int?
  maxInquiriesPerInterview   Int?
  documentAnalysesPerDay     Int?
  reportGenerationsPerDay    Int?
  concurrentActiveInterviews Int?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  user                       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UsageCounter {
  id                       String          @id @default(cuid())
  scopeType                UsageScopeType
  scopeId                  String
  periodType               UsagePeriodType
  periodStart              DateTime
  requestsUsed             Int             @default(0)
  requestsReserved         Int             @default(0)
  tokensUsed               Int             @default(0)
  tokensReserved           Int             @default(0)
  costUsed                 Decimal         @default(0) @db.Decimal(18, 6)
  costReserved             Decimal         @default(0) @db.Decimal(18, 6)
  interviewsCreated        Int             @default(0)
  interviewsReserved       Int             @default(0)
  documentAnalyses         Int             @default(0)
  documentAnalysesReserved Int             @default(0)
  reportsGenerated         Int             @default(0)
  reportsReserved          Int             @default(0)
  demoInterviewsCreated    Int             @default(0)
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  @@unique([scopeType, scopeId, periodType, periodStart])
  @@index([scopeType, scopeId, periodType])
}

model AIUsageRecord {
  id                 String          @id @default(cuid())
  userId             String?
  interviewId        String?
  operation          AIOperationType
  model              String
  status             AIUsageStatus   @default(RESERVED)
  reservedRequests   Int             @default(1)
  reservedTokens     Int             @default(0)
  reservedCost       Decimal         @default(0) @db.Decimal(18, 6)
  actualRequests     Int             @default(0)
  actualInputTokens  Int             @default(0)
  actualOutputTokens Int             @default(0)
  actualTokens       Int             @default(0)
  ttsCharacters      Int             @default(0)
  costEstimated      Decimal         @default(0) @db.Decimal(18, 6)
  periodDayStart     DateTime
  periodMonthStart   DateTime
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  user               User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([model, createdAt])
  @@index([status, createdAt])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
}

model UploadedDocument {
  id            String                 @id @default(cuid())
  userId        String
  type          DocumentType
  sourceKind    DocumentSourceKind     @default(FILE)
  originalName  String?
  mimeType      String?
  sizeBytes     Int?
  storageFileId String?
  status        DocumentStatus         @default(UPLOADED)
  failureReason DocumentFailureReason?
  summaryJson   Json?
  pastedText    String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([userId, status])
}
