generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETING
}

enum UserStatusType {
  STUDENT
  PROFESSIONAL
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  EXPERIENCED
}

enum InterviewCategory {
  TECHNICAL
  HR
  BEHAVIORAL
}

enum QuotaProfile {
  DEMO
  FREE_USER
}

enum UsageScopeType {
  GLOBAL
  USER
}

enum UsagePeriodType {
  DAY
  MONTH
}

enum DocumentType {
  CV
  JD
}

enum DocumentSourceKind {
  FILE
  PASTED
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED
}

enum DocumentFailureReason {
  INVALID_FILE
  NO_TEXT
  EXTRACTION_FAILED
  PROCESSING_FAILED
}

enum AIOperationType {
  DOCUMENT_SUMMARY
  DOCUMENT_EMBEDDING
  QUERY_EMBEDDING
  INTERVIEW_PLAN
  ANSWER_EVALUATION
  CANDIDATE_INQUIRY
  REPORT_GENERATION
  SPEECH_TRANSCRIPTION
  SPEECH_SYNTHESIS
}

enum AIUsageStatus {
  RESERVED
  SETTLED
  RELEASED
  FAILED
  EXPIRED
}

enum InterviewMode {
  GENERAL
  CV_BASED
  JD_BASED
  CV_JD
}

enum InterviewType {
  TECHNICAL
  HR
  BEHAVIORAL
}

enum InterviewDifficulty {
  EASY
  MEDIUM
  HARD
}

enum InterviewStatus {
  CREATED
  IN_PROGRESS
  COMPLETED
  ENDED_EARLY
  TIMED_OUT
  FAILED
}

enum InterviewRuntimeState {
  INITIALIZING
  RECRUITER_SPEAKING
  WAITING_FOR_CANDIDATE
  CANDIDATE_LISTENING
  PROCESSING_ANSWER
  AI_THINKING
  GENERATING_NEXT_QUESTION
  GENERATING_FEEDBACK
  INTERVIEW_COMPLETED
  ERROR
}

enum InterviewEndReason {
  USER_ENDED
  TIME_LIMIT
  QUESTIONS_COMPLETED
  ABANDONED
  ERROR
}

enum ReportStatus {
  PENDING
  READY
  FAILED
}

enum QuestionKind {
  MAIN
  FOLLOW_UP
  CLARIFICATION
}

model ApplicationSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String?
  role                UserRole             @default(USER)
  status              UserStatus           @default(ACTIVE)
  isDemo              Boolean              @default(false)
  tokenVersion        Int                  @default(0)
  lastLoginAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  profile             UserProfile?
  passwordResetTokens PasswordResetToken[]
  quota               UserQuota?
  aiUsageRecords      AIUsageRecord[]
  documents           UploadedDocument[]
  documentChunks      DocumentChunk[]
  interviews          Interview[]

  @@index([status, role, isDemo])
}

model UserProfile {
  id                    String              @id @default(cuid())
  userId                String              @unique
  fullName              String?
  statusType            UserStatusType?
  experienceLevel       ExperienceLevel?
  targetRole            String?
  careerGoals           String?
  preferredCategories   InterviewCategory[]
  onboardingCompletedAt DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model QuotaConfiguration {
  id                         String       @id @default(cuid())
  profile                    QuotaProfile @unique
  interviewsPerDay           Int
  maxDurationMinutes         Int
  maxQuestionsPerInterview   Int
  maxInquiriesPerInterview   Int
  documentAnalysesPerDay     Int
  reportGenerationsPerDay    Int
  concurrentActiveInterviews Int
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt
}

model UserQuota {
  id                         String   @id @default(cuid())
  userId                     String   @unique
  interviewsPerDay           Int?
  maxDurationMinutes         Int?
  maxQuestionsPerInterview   Int?
  maxInquiriesPerInterview   Int?
  documentAnalysesPerDay     Int?
  reportGenerationsPerDay    Int?
  concurrentActiveInterviews Int?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  user                       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UsageCounter {
  id                       String          @id @default(cuid())
  scopeType                UsageScopeType
  scopeId                  String
  periodType               UsagePeriodType
  periodStart              DateTime
  requestsUsed             Int             @default(0)
  requestsReserved         Int             @default(0)
  tokensUsed               Int             @default(0)
  tokensReserved           Int             @default(0)
  costUsed                 Decimal         @default(0) @db.Decimal(18, 6)
  costReserved             Decimal         @default(0) @db.Decimal(18, 6)
  interviewsCreated        Int             @default(0)
  interviewsReserved       Int             @default(0)
  documentAnalyses         Int             @default(0)
  documentAnalysesReserved Int             @default(0)
  reportsGenerated         Int             @default(0)
  reportsReserved          Int             @default(0)
  demoInterviewsCreated    Int             @default(0)
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  @@unique([scopeType, scopeId, periodType, periodStart])
  @@index([scopeType, scopeId, periodType])
}

model AIUsageRecord {
  id                 String          @id @default(cuid())
  userId             String?
  interviewId        String?
  operation          AIOperationType
  model              String
  status             AIUsageStatus   @default(RESERVED)
  reservedRequests   Int             @default(1)
  reservedTokens     Int             @default(0)
  reservedCost       Decimal         @default(0) @db.Decimal(18, 6)
  actualRequests     Int             @default(0)
  actualInputTokens  Int             @default(0)
  actualOutputTokens Int             @default(0)
  actualTokens       Int             @default(0)
  ttsCharacters      Int             @default(0)
  costEstimated      Decimal         @default(0) @db.Decimal(18, 6)
  periodDayStart     DateTime
  periodMonthStart   DateTime
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  user               User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  interview          Interview?      @relation(fields: [interviewId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([interviewId, createdAt])
  @@index([model, createdAt])
  @@index([status, createdAt])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
}

model UploadedDocument {
  id            String                 @id @default(cuid())
  userId        String
  type          DocumentType
  sourceKind    DocumentSourceKind     @default(FILE)
  originalName  String?
  mimeType      String?
  sizeBytes     Int?
  storageFileId String?
  status        DocumentStatus         @default(UPLOADED)
  failureReason DocumentFailureReason?
  summaryJson   Json?
  pastedText    String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks        DocumentChunk[]
  cvConfigs     InterviewConfiguration[] @relation("CvConfig")
  jdConfigs     InterviewConfiguration[] @relation("JdConfig")

  @@index([userId, type])
  @@index([userId, status])
}

model DocumentChunk {
  id         String                      @id @default(cuid())
  documentId String
  userId     String
  chunkIndex Int
  content    String                      @db.Text
  embedding  Unsupported("vector(768)")?
  createdAt  DateTime                    @default(now())

  document   UploadedDocument            @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User                        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([userId, documentId])
}

model Interview {
  id           String                 @id @default(cuid())
  userId       String
  mode         InterviewMode
  status       InterviewStatus        @default(CREATED)
  runtimeState InterviewRuntimeState  @default(INITIALIZING)
  state        Json
  startedAt    DateTime?
  endedAt      DateTime?
  endReason    InterviewEndReason?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  configuration  InterviewConfiguration?
  questions      InterviewQuestion[]
  answers        CandidateAnswer[]
  inquiries      CandidateInquiry[]
  aiUsageRecords AIUsageRecord[]
  report         InterviewReport?

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model InterviewConfiguration {
  id              String              @id @default(cuid())
  interviewId     String              @unique
  role            String
  experienceLevel ExperienceLevel
  type            InterviewType
  startDifficulty InterviewDifficulty
  durationMinutes Int
  maxQuestions    Int
  cvDocumentId    String?
  jdDocumentId    String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  interview  Interview         @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  cvDocument UploadedDocument? @relation("CvConfig", fields: [cvDocumentId], references: [id], onDelete: SetNull)
  jdDocument UploadedDocument? @relation("JdConfig", fields: [jdDocumentId], references: [id], onDelete: SetNull)
}

model InterviewQuestion {
  id          String              @id @default(cuid())
  interviewId String
  orderIndex  Int
  kind        QuestionKind        @default(MAIN)
  topic       String
  difficulty  InterviewDifficulty
  text        String              @db.Text
  textHash    String
  createdAt   DateTime            @default(now())

  interview Interview          @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  answer    CandidateAnswer?
  inquiries CandidateInquiry[]

  @@unique([interviewId, orderIndex])
  @@unique([interviewId, textHash])
  @@index([interviewId, kind])
}

model CandidateAnswer {
  id              String            @id @default(cuid())
  interviewId     String
  questionId      String            @unique
  transcript      String            @db.Text
  isEmpty         Boolean           @default(false)
  durationSeconds Int?
  clientRequestId String?
  createdAt       DateTime          @default(now())

  interview  Interview         @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  question   InterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  evaluation AnswerEvaluation?

  @@unique([interviewId, clientRequestId])
  @@index([interviewId, createdAt])
}

model AnswerEvaluation {
  id                     String          @id @default(cuid())
  answerId               String          @unique
  overallScore           Int             @default(0)
  criteriaScores         Json
  starParts              Json?
  correct                String?         @db.Text
  missing                String?         @db.Text
  strengths              Json?
  weaknesses             Json?
  improvements           Json?
  idealAnswer            String?         @db.Text
  followUpRecommendation String?
  reasoning              String?         @db.Text
  createdAt              DateTime        @default(now())

  answer CandidateAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@index([answerId])
}

model CandidateInquiry {
  id              String            @id @default(cuid())
  interviewId     String
  questionId      String?
  transcript      String            @db.Text
  reply           String            @db.Text
  clientRequestId String?
  createdAt       DateTime          @default(now())

  interview Interview          @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  question  InterviewQuestion? @relation(fields: [questionId], references: [id], onDelete: SetNull)

  @@unique([interviewId, clientRequestId])
  @@index([interviewId, createdAt])
}

model InterviewReport {
  id              String        @id @default(cuid())
  interviewId     String        @unique
  status          ReportStatus  @default(PENDING)
  summary         String?       @db.Text
  strengths       Json?
  weaknesses      Json?
  recommendations Json?
  studyTopics     Json?
  generatedAt     DateTime?
  failureReason   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([interviewId, status])
}

